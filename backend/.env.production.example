# ==============================================================================
# VahaanRent India - Production Environment Variables Template
# ==============================================================================
# Copy this file to `.env` in the backend directory for production deployment.

NODE_ENV=production
PORT=4000

# 1. Database (MongoDB Atlas)
# Replace with your MongoDB connection string from mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vahaanrent?retryWrites=true&w=majority

# 2. Razorpay India Payments Gateway
# Obtain from https://dashboard.razorpay.com/#/access/api-keys
RAZORPAY_KEY_ID=rzp_live_YourKeyHere
RAZORPAY_KEY_SECRET=YourSecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# 3. Mode Toggle (Set to 'false' for live production with real gateways)
# 'true' allows simulated OTPs & sandbox fallbacks without blocking users
DEMO_MODE=false

# 4. SMS / WhatsApp Gateway (Twilio or Fast2SMS / MSG91)
# For real SMS OTP delivery to Indian mobile numbers (+91)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# 5. Transactional Email / SMTP Gateway
# For booking confirmations, GST tax invoices, and password resets
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_ses_api_key
EMAIL_FROM="VahaanRent India" <no-reply@vahaanrent.in>

# 6. Persistent Cloud Storage (Cloudinary or AWS S3)
# For vehicle inspection photos, RC scans, and avatar uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# 7. JWT & Session Security
# Generate a unique secure secret: openssl rand -hex 32
JWT_SECRET=replace_with_a_unique_64_character_secret

# 8. Apache Kafka / Event Stream (Optional: Confluent Cloud or Local Kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=vahaanrent-production
