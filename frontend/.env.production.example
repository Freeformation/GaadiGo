# ==============================================================================
# VahaanRent India - Frontend Production Environment Variables Template
# ==============================================================================
# Copy this file to `.env.production` in the frontend directory.

# 1. API GraphQL & REST Endpoint
VITE_API_URL=https://api.yourdomain.com/graphql
VITE_REST_API_URL=https://api.yourdomain.com

# 2. Razorpay Public Client Key
# Use your Razorpay Live or Test Key ID (publicly safe)
VITE_RAZORPAY_KEY_ID=rzp_live_YourKeyHere
